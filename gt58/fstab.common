system_dlkm	/system_dlkm	ext4	ro				wait,logical,first_stage_mount
/dev/block/platform/soc@0/7824900.mmc/by-name/userdata /data ext4 noatime,nosuid,nodev,barrier=1,noauto_da_alloc latemount,wait,formattable,quota
/dev/block/platform/soc@0/7824900.mmc/by-name/persist /mnt/vendor/persist ext4 noatime,ro,noauto_da_alloc wait
